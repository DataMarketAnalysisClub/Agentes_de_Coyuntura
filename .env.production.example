APP_ENV=production
TZ=America/Santiago
DRY_RUN=false

# SMTP (Outlook/Microsoft 365 or compatible provider)
EMAIL_ENABLED=true
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=<REEMPLAZAR_POR_APP_PASSWORD>
EMAIL_FROM=notifications@example.com
EMAIL_FROM_NAME=DMAC Brief · Nix
EMAIL_TO=recipient@example.com
EMAIL_CC=
# Avisos de salud de fuentes (mantenedores). Vacio = solo log.
OPS_EMAIL_TO=

# Mailing con suscripcion (MySQL + servicio web). Ver DEPLOY.md.
MAILING_ENABLED=false
# COMPOSE_PROFILES=mailing
MAILING_PUBLIC_URL=
# Tope de correos de confirmacion por hora: protege la cuota diaria de Gmail
# (~500 destinatarios) si un bot llena el formulario. Produccion usa 10.
MAILING_CONFIRM_MAX_PER_HOUR=10
# Puerto del servidor (solo 127.0.0.1) al que apunta Tailscale Funnel.
# MAILING_HOST_PORT=8080
MYSQL_DATABASE=dmac_mailing
MYSQL_USER=dmac_mailing
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Banco Central de Chile (credenciales en archivo externo, no en .env)
BCENTRAL_CREDENTIALS_FILE=/app/credentials/bcentral.txt
BCENTRAL_TPM_SERIES=F022.TPM.TIN.D001.NO.Z.D
BCENTRAL_IPC_SERIES=F074.IPC.VAR.Z.Z.C.M
BCENTRAL_UNEMPLOYMENT_SERIES=F049.DES.TAS.INE9.10.M
BCENTRAL_USDPEN_SERIES=F072.PEN.USD.N.O.D
BCENTRAL_IPC12_SERIES=F074.IPC.V12.Z.EP23.C.M
BCENTRAL_IMACEC_SERIES=F032.IMC.V12.Z.Z.2018.Z.Z.0.M
BCENTRAL_DOLAR_OBSERVADO_SERIES=F073.TCO.PRE.Z.D
BCENTRAL_UF_SERIES=F073.UFF.PRE.Z.D
BCENTRAL_COPPER_SERIES=F019.PPB.PRE.100.D
BCENTRAL_TIMEOUT_SECONDS=20

MARKET_DATA_PROVIDER=yfinance
DATABASE_URL=sqlite:///storage/dmac_market_brief.db

HIGH_IMPACT_THRESHOLD=8
ALERT_MONITOR_ENABLED=false
ALERT_DEDUP_HOURS=3
NEWS_MENTION_LOOKBACK_HOURS=720

# RSS feeds (CSV, leave empty for defaults)
RSS_FEEDS=

# IA editorial (Ollama Cloud)
AI_ENABLED=true
AI_DRY_RUN=false
AI_STRICT_JSON=true
AI_MAX_NEWS_ITEMS=30
AI_OUTPUT_DIR=outputs/ai
AI_MAX_GROUPS=6
AI_MAX_NEWS_PER_GROUP=10
AI_CHARTS_ENABLED=true
AI_MAX_CHARTS=4
AI_CHART_OUTPUT_DIR=outputs/ai/charts
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=<REEMPLAZAR_POR_TU_OLLAMA_KEY>
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_RETRIES=2

# Comparador IA: en servidor real, mock=false
OLLAMA_COMPARE_MODELS=gpt-oss:120b
AI_COMPARE_USE_MOCK=false
