APP_ENV=local
TZ=America/Santiago
DRY_RUN=true

EMAIL_ENABLED=false
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=DMAC Brief · Nix
EMAIL_TO=
EMAIL_CC=
# Avisos de salud de fuentes (mantenedores). Vacio = solo log.
OPS_EMAIL_TO=

BCENTRAL_USER=
BCENTRAL_PASSWORD=
BCENTRAL_CREDENTIALS_FILE=
BCENTRAL_TPM_SERIES=F022.TPM.TIN.D001.NO.Z.D
BCENTRAL_IPC_SERIES=F074.IPC.VAR.Z.Z.C.M
BCENTRAL_UNEMPLOYMENT_SERIES=F049.DES.TAS.INE9.10.M
BCENTRAL_USDPEN_SERIES=F072.PEN.USD.N.O.D
BCENTRAL_IPC12_SERIES=F074.IPC.V12.Z.EP23.C.M
BCENTRAL_IMACEC_SERIES=F032.IMC.V12.Z.Z.2018.Z.Z.0.M
BCENTRAL_DOLAR_OBSERVADO_SERIES=F073.TCO.PRE.Z.D
BCENTRAL_UF_SERIES=F073.UFF.PRE.Z.D
BCENTRAL_COPPER_SERIES=F019.PPB.PRE.100.D
BCENTRAL_TIMEOUT_SECONDS=20

MARKET_DATA_PROVIDER=yfinance
DATABASE_URL=sqlite:///storage/dmac_market_brief.db

HIGH_IMPACT_THRESHOLD=8
ALERT_MONITOR_ENABLED=false
ALERT_DEDUP_HOURS=3
NEWS_MENTION_LOOKBACK_HOURS=720

# RSS feeds (comma-separated, leave empty for defaults)
# Defaults: Federal Reserve, ECB, Financial Times, MarketWatch, Investing.com
RSS_FEEDS=

# AI / Ollama Cloud (Phase 1: smoke test only)
AI_ENABLED=false
AI_DRY_RUN=true
AI_STRICT_JSON=true
AI_MAX_NEWS_ITEMS=30
AI_OUTPUT_DIR=outputs/ai
AI_MAX_GROUPS=6
AI_MAX_NEWS_PER_GROUP=10
# Phase 3: editorial email + charts
AI_CHARTS_ENABLED=true
AI_MAX_CHARTS=4
AI_CHART_OUTPUT_DIR=outputs/ai/charts
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_RETRIES=2

# Phase 6: editorial comparison (fallback vs IA)
# OLLAMA_COMPARE_MODELS=gpt-oss:120b,other-model
OLLAMA_COMPARE_MODELS=
# Set to 1/true to use the mock dataset in ai-review-compare (no RSS/scraping).
AI_COMPARE_USE_MOCK=false
